# ─── Email (contact form) ──────────────────────────────────────────────────────
# Transport: Resend (https://resend.com). Free tier: 3,000 emails/month,
# 100/day. Setup checklist: docs/email-resend.md

# The only secret. Create it at https://resend.com/api-keys with "Sending
# access" only, scoped to the relier.com domain. Without it the app runs in dry
# mode: it logs the email instead of sending (and returns 503 in production).
RESEND_API_KEY=

# Sender. The domain must be verified in Resend or the API rejects the send.
CONTACT_FROM_EMAIL="Relier Website <info@relier.com>"

# Where enquiries land. Comma-separated for several recipients.
CONTACT_TO_EMAIL=info@relier.com

# Set to "true" to log emails instead of sending them, even with a key present.
# EMAIL_DRY_RUN=false

# ─── Analytics ────────────────────────────────────────────────────────────────
# Public by definition (they ship in the page source), so NEXT_PUBLIC_ is right
# and carries no secret. Unset means no tracking at all — which is what we want
# locally, so nobody's `npm run dev` lands in the client's reports.
# Full picture of what fires where: docs/analytics.md

# GTM container. Carries Google Ads AW-17772455341 + Meta pixel 4423881761234988.
NEXT_PUBLIC_GTM_ID=GTM-KCLH74B7

# GA4 measurement id. Comma-separated to also feed a legacy property; the first
# one loads gtag.js and the rest ride along as extra destinations.
# Neither GTM container carries a GA4 tag, which is why this is wired directly.
NEXT_PUBLIC_GA4_ID=G-CV2QZ9VV0M

# ─── Booking (Limo Anywhere) — still mocked, not wired yet ─────────────────────
# LIMOANYWHERE_API_ID=
# LIMOANYWHERE_API_KEY=
# LIMOANYWHERE_USER_ID=

# ─── Maps — only if we ever swap MapLibre for Mapbox ──────────────────────────
# NEXT_PUBLIC_MAPBOX_TOKEN=
